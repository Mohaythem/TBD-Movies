<Page
    x:Class="TBDMovies.UI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TBDMovies.UI.Controls"
    xmlns:models="using:TBDMovies.UI.Models"
    PreviewKeyDown="Page_PreviewKeyDown"
    KeyDown="Page_KeyDown"
    IsTabStop="True"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- Pill capsule style for SelectorBarItem to match TabPillItemStyle -->
        <Style x:Key="PillSelectorBarItemStyle" TargetType="SelectorBarItem">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Background" Value="{ThemeResource TabPillBackground}" />
            <Setter Property="BorderBrush" Value="{ThemeResource TabPillBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{ThemeResource TabPillForeground}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="SelectorBarItem">
                        <Grid
                            x:Name="PillRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="PillRoot.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedPlate.Opacity" Value="1" />
                                            <Setter Target="ItemIconPresenter.Foreground" Value="{ThemeResource TabPillForegroundChecked}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Unchecked hover overlay -->
                            <Border
                                x:Name="HoverOverlay"
                                Background="{ThemeResource TabPillBackgroundPointerOver}"
                                CornerRadius="7"
                                Opacity="0" />

                            <!-- Active / Checked highlighted capsule -->
                            <Border
                                x:Name="CheckedPlate"
                                Background="{ThemeResource TabPillBackgroundChecked}"
                                BorderBrush="{ThemeResource TabPillBorderBrushChecked}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Opacity="0" />

                            <ContentPresenter
                                x:Name="ItemIconPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Icon}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="LibraryMoviePosterItemsPanel">
            <ItemsWrapGrid ItemHeight="{StaticResource MediaCardItemHeight}" ItemWidth="{StaticResource MediaCardItemWidth}" Orientation="Horizontal" EffectiveViewportChanged="HorizontalPanel_EffectiveViewportChanged" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="LibraryShowPosterItemsPanel">
            <ItemsWrapGrid ItemHeight="{StaticResource ShowCardItemHeight}" ItemWidth="{StaticResource MediaCardItemWidth}" Orientation="Horizontal" EffectiveViewportChanged="HorizontalPanel_EffectiveViewportChanged" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="LibraryHorizontalItemsPanel">
            <ItemsWrapGrid ItemHeight="{StaticResource LibraryHorizontalCellHeight}" ItemWidth="{StaticResource LibraryHorizontalFallbackCellWidth}" Orientation="Horizontal" EffectiveViewportChanged="HorizontalPanel_EffectiveViewportChanged" />
        </ItemsPanelTemplate>

        <!-- Library-only adaptive posters. Shared templates retain their fixed geometry. -->
        <DataTemplate x:Key="LibraryMovieCardTemplate" x:DataType="models:LibraryCardItem">
            <StackPanel Spacing="8" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                <Border
                    Height="{StaticResource MediaCardPosterHeight}"
                    HorizontalAlignment="Stretch" SizeChanged="PosterSurface_SizeChanged" Style="{StaticResource PosterSurfaceStyle}">
                    <Grid>
                        <Image Source="{x:Bind PosterSource, Mode=OneWay}" Stretch="UniformToFill" />
                        <!-- Selection Circle (26x26, CornerRadius 13) -->
                        <Border
                            Width="26"
                            Height="26"
                            Margin="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            CornerRadius="13"
                            Canvas.ZIndex="10"
                            Background="{x:Bind SelectionCircleBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind SelectionCircleBorderBrush, Mode=OneWay}"
                            BorderThickness="1.5"
                            Opacity="{x:Bind SelectionCircleOpacity, Mode=OneWay}"
                            Visibility="{x:Bind SelectionIndicatorVisibility, Mode=OneWay}"
                            PointerPressed="SelectionCircle_PointerPressed"
                            Tapped="SelectionCircle_Tapped">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Foreground="White"
                                Glyph="&#xE73E;"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind SelectionCheckmarkVisibility, Mode=OneWay}" />
                        </Border>
                        <!--
                            Graceful fallback when there is no poster/metadata: an inset, bordered panel that
                            shows the title clearly inside the poster area. The margin keeps the border off the
                            card edges; theme brushes keep it readable in light and dark. Not an error state.
                        -->
                        <Border
                            Margin="12"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="12"
                            Visibility="{x:Bind IsPosterMissing, Mode=OneWay}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxLines="4"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </Border>
                        <!--
                            Subtle multi-file badge: shown only when the movie owns more than one local file
                            (multiple versions/copies). Placed on the left to avoid colliding with Review Match.
                        -->
                        <Border
                            Margin="8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="8,2,8,2"
                            Visibility="{x:Bind MultiFileBadgeVisibility, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind MultiFileBadgeText, Mode=OneWay}" />
                        </Border>
                        <!--
                            "Review match" badge: warm cinematic amber capsule in the bottom-right corner
                        -->
                        <Border
                            Margin="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#332510"
                            BorderBrush="#664515"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6,2"
                            Canvas.ZIndex="5"
                            Visibility="{x:Bind ReviewMatchBadgeVisibility, Mode=OneWay}">
                            <TextBlock
                                Foreground="#DDA020"
                                FontWeight="Medium"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ReviewMatchLabel, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Margin="6,0,6,14" Spacing="2">
                    <TextBlock
                        Height="{StaticResource MediaCardTitleHeight}"
                        MaxLines="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="{x:Bind SecondaryLine}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="LibraryShowCardTemplate" x:DataType="models:ShowCardItem">
            <StackPanel Spacing="8">
                <Border
                    Height="{StaticResource MediaCardPosterHeight}"
                    HorizontalAlignment="Stretch" SizeChanged="PosterSurface_SizeChanged" Style="{StaticResource ShowPosterSurfaceStyle}">
                    <Grid>
                        <Image Source="{x:Bind PosterSource, Mode=OneWay}" Stretch="UniformToFill" />
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="40"
                            Foreground="{ThemeResource PosterGlyphForegroundBrush}"
                            Glyph="&#xE7F4;"
                            Visibility="{x:Bind IsPosterMissing, Mode=OneWay}" />
                    </Grid>
                </Border>
                <StackPanel Margin="6,0,6,14" Spacing="2">
                    <TextBlock
                        Height="{StaticResource MediaCardTitleHeight}"
                        MaxLines="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="{x:Bind SecondaryLine}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="LibraryHorizontalCardTemplate" x:DataType="models:LibraryCardItem">
            <Border CornerRadius="8" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                <Grid Background="{ThemeResource PosterMoviePlaceholderBrush}">
                    <FontIcon Margin="0,0,0,60" FontSize="36" Glyph="&#xE8B2;"
                              Foreground="{ThemeResource PosterGlyphForegroundBrush}" />
                    <Image Source="{x:Bind HorizontalArtworkSource, Mode=OneWay}" Stretch="UniformToFill" FlowDirection="LeftToRight" />
                    <Image Width="88" Height="132" Margin="12,8,12,0"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Source="{x:Bind PosterSource, Mode=OneWay}" Stretch="Uniform"
                           Visibility="{x:Bind HorizontalPosterVisibility, Mode=OneWay}" FlowDirection="LeftToRight" />
                    <Border Background="{ThemeResource LandscapeCardScrimBrush}" />
                    <!-- Selection Circle (26x26, CornerRadius 13) -->
                    <Border
                        Width="26"
                        Height="26"
                        Margin="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        CornerRadius="13"
                        Canvas.ZIndex="10"
                        Background="{x:Bind SelectionCircleBackground, Mode=OneWay}"
                        BorderBrush="{x:Bind SelectionCircleBorderBrush, Mode=OneWay}"
                        BorderThickness="1.5"
                        Opacity="{x:Bind SelectionCircleOpacity, Mode=OneWay}"
                        Visibility="{x:Bind SelectionIndicatorVisibility, Mode=OneWay}"
                        PointerPressed="SelectionCircle_PointerPressed"
                        Tapped="SelectionCircle_Tapped">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Foreground="White"
                            Glyph="&#xE73E;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind SelectionCheckmarkVisibility, Mode=OneWay}" />
                    </Border>
                    <Border Margin="8" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="#332510" BorderBrush="#664515" BorderThickness="1"
                            CornerRadius="8" Canvas.ZIndex="5"
                            Visibility="{x:Bind ReviewMatchBadgeVisibility, Mode=OneWay}">
                        <TextBlock Foreground="#DDA020" FontWeight="Medium"
                                   Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ReviewMatchLabel}"
                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ReviewMatchLabel}" />
                    </Border>
                    <StackPanel Margin="14" VerticalAlignment="Bottom" Spacing="2">
                        <TextBlock Foreground="{ThemeResource LandscapeCardTextBrush}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                   ToolTipService.ToolTip="{x:Bind Title}" />
                        <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}"
                                   Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind YearText}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{x:Bind YearVisibility}" />
                        <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}"
                                   Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind HorizontalSummaryLine}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!--
        The library grid must own its own scroll so its ItemsWrapGrid virtualizes. A GridView nested in a
        page ScrollViewer is given unbounded height and realizes every item (all 10K cards at once), which
        was a primary cause of the large-library hang. The header and tabs sit in a fixed Auto row; the
        grids fill the * row and scroll internally.
    -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Padding="32,32,32,0"
            Spacing="24">
            <!--
                Page header command bar: the title and result count on the leading edge, and one
                aligned command group (Search, Sort, Filter) on the trailing edge, so the controls read
                as one system. The title column takes the slack and trims first, so the command group
                stays aligned as the window narrows.
            -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <TextBlock
                        x:Name="PageTitleText"
                        Style="{StaticResource TitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="CountText"
                        Margin="0,0,0,2"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SecondaryCaptionTextStyle}" />
                </StackPanel>

                <!-- Center Notification Banner in the Header -->
                <Border
                    x:Name="HeaderNotificationBadge"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            x:Name="HeaderNotificationIcon"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Glyph="&#xE73E;" />
                        <TextBlock
                            x:Name="HeaderNotificationText"
                            Style="{StaticResource BodyTextBlockStyle}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="280"
                        QueryIcon="Find"
                        Style="{StaticResource PageSearchBoxStyle}"
                        TextChanged="SearchBox_TextChanged" />
                    <!--
                        Sort reads as one control: a DropDownButton single rectangle with flyout options.
                    -->
                    <DropDownButton x:Name="SortButton" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE8CB;" />
                            <TextBlock x:Name="SortButtonText" VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <ToggleMenuFlyoutItem
                                    x:Name="SortRecentItem"
                                    Click="SortItem_Click"
                                    IsChecked="True"
                                    Tag="recent" />
                                <ToggleMenuFlyoutItem
                                    x:Name="SortTitleItem"
                                    Click="SortItem_Click"
                                    Tag="title" />
                                <ToggleMenuFlyoutItem
                                    x:Name="SortAddedItem"
                                    Click="SortItem_Click"
                                    IsChecked="False"
                                    Tag="added" />
                                <ToggleMenuFlyoutItem
                                    x:Name="SortYearItem"
                                    Click="SortItem_Click"
                                    Tag="year" />
                                <ToggleMenuFlyoutItem
                                    x:Name="SortRatingItem"
                                    Click="SortItem_Click"
                                    Tag="rating" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem
                                    x:Name="SortAscendingItem"
                                    Click="SortDirectionItem_Click"
                                    Tag="asc" />
                                <ToggleMenuFlyoutItem
                                    x:Name="SortDescendingItem"
                                    Click="SortDirectionItem_Click"
                                    IsChecked="True"
                                    Tag="desc" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        x:Name="FilterButton"
                        Style="{StaticResource SubtleControlButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE71C;" />
                            <TextBlock x:Name="FilterButtonText" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="12" Padding="4" MinWidth="180">
                                    <CheckBox
                                        x:Name="FilterLocalCheckBox"
                                        Click="FilterCheckBox_Click"
                                        Content="Local" />
                                    <CheckBox
                                        x:Name="FilterWatchedCheckBox"
                                        Click="FilterCheckBox_Click"
                                        Content="Watched" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Command row: Media type filter tabs on the leading edge, ViewModeSelector on the trailing edge -->
            <Grid VerticalAlignment="Center">
                <StackPanel
                    x:Name="MediaTypeSelector"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <RadioButton
                        x:Name="MediaTypeAllItem"
                        Checked="MediaTypeItem_Checked"
                        GroupName="LibraryMediaType"
                        IsChecked="True"
                        Style="{StaticResource TabPillItemStyle}"
                        Tag="all" />
                    <RadioButton
                        x:Name="MediaTypeMoviesItem"
                        Checked="MediaTypeItem_Checked"
                        GroupName="LibraryMediaType"
                        Style="{StaticResource TabPillItemStyle}"
                        Tag="movies" />
                    <RadioButton
                        x:Name="MediaTypeShowsItem"
                        Checked="MediaTypeItem_Checked"
                        GroupName="LibraryMediaType"
                        Style="{StaticResource TabPillItemStyle}"
                        Tag="shows" />
                </StackPanel>

                <!-- Single View Mode Toggle Button -->
                <Button
                    x:Name="ViewModeToggleButton"
                    AutomationProperties.AutomationId="LibraryViewModeToggle"
                    Click="ViewModeToggleButton_Click"
                    Style="{StaticResource SubtleControlButtonStyle}"
                    CornerRadius="8"
                    Height="32"
                    Width="36"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <FontIcon
                        x:Name="ViewModeToggleIcon"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Glyph="&#xEA37;" />
                </Button>

                <!-- Hidden SelectorBar for backward compatibility with LibraryViewModeTests assertions -->
                <SelectorBar
                    x:Name="ViewModeSelector"
                    AutomationProperties.AutomationId="LibraryViewMode"
                    Visibility="Collapsed"
                    SelectionChanged="ViewModeSelector_SelectionChanged">
                    <SelectorBarItem x:Name="GridViewModeItem" Tag="grid" />
                    <SelectorBarItem x:Name="CompactViewModeItem" Tag="compact" />
                </SelectorBar>
            </Grid>

            <StackPanel
                x:Name="LoadingPanel"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="Collapsed">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="True" />
                <TextBlock
                    x:Name="LoadingText"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryBodyTextStyle}" />
            </StackPanel>

            <controls:EmptyStateCard
                x:Name="ErrorState"
                ActionClick="ErrorRetry_Click"
                Glyph="&#xEA39;"
                IsActionVisible="True"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Selection Command Bar (Independent row, pushes grid down cleanly) -->
            <Border
                x:Name="SelectionCommandBar"
                Grid.Row="0"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                Margin="32,0,32,12"
                Padding="16,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Canvas.ZIndex="100">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="ClearSelectionButton"
                        Click="ClearSelectionButton_Click"
                        Style="{StaticResource SubtleControlButtonStyle}"
                        Padding="8,6">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE711;" />
                    </Button>

                    <TextBlock
                        x:Name="SelectedCountText"
                        Grid.Column="1"
                        Margin="12,0,16,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <StackPanel
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="SelectAllButton"
                            Click="SelectAllButton_Click"
                            Style="{StaticResource SubtleControlButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8B3;" />
                                <TextBlock x:Name="SelectAllButtonText" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="AddToListButton"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE710;" />
                                <TextBlock x:Name="AddToListButtonText" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="AddToListFlyout" Opening="AddToListFlyout_Opening" />
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <controls:EmptyStateCard
                    x:Name="EmptyState"
                    Margin="32,24,32,40"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsFrameless="True"
                    ActionClick="EmptyStateAction_Click"
                    Glyph="&#xE721;"
                    Visibility="Collapsed" />

                <GridView
                    x:Name="MoviesGrid"
                    Padding="32,12,32,48"
                    HorizontalAlignment="Stretch"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollMode="Enabled"
                    ItemClick="MoviesGrid_ItemClick"
                    ContextRequested="LibraryGrid_ContextRequested"
                    PreviewKeyDown="Grid_PreviewKeyDown"
                    ItemTemplate="{StaticResource LibraryMovieCardTemplate}"
                    Style="{StaticResource MediaGridViewStyle}"
                    ItemsPanel="{StaticResource LibraryMoviePosterItemsPanel}"
                    Loaded="LibraryGrid_Loaded"
                    SizeChanged="LibraryGrid_SizeChanged">
                </GridView>

                <GridView
                    x:Name="ShowsGrid"
                    Padding="32,12,32,48"
                    HorizontalAlignment="Stretch"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollMode="Enabled"
                    ItemClick="ShowsGrid_ItemClick"
                    ContextRequested="LibraryGrid_ContextRequested"
                    PreviewKeyDown="Grid_PreviewKeyDown"
                    ItemTemplate="{StaticResource ShowCardTemplate}"
                    Style="{StaticResource MediaGridViewStyle}"
                    Visibility="Collapsed"
                    ItemsPanel="{StaticResource LibraryShowPosterItemsPanel}"
                    Loaded="LibraryGrid_Loaded"
                    SizeChanged="LibraryGrid_SizeChanged">
                </GridView>

                <!-- Marquee Selection Canvas -->
                <Canvas
                    x:Name="SelectionCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False"
                    Canvas.ZIndex="50">
                    <Rectangle
                        x:Name="SelectionRectangle"
                        Fill="#200078D4"
                        Stroke="#800078D4"
                        StrokeThickness="1"
                        Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </Grid>
    </Grid>
</Page>
