<!--
    My Lists.

    Mirrors PersonalLibrary.tsx: a page header (title + list count + accent New List) with the page
    search directly beneath it, the four-list tab strip where the active tab also shows its item
    count, then the list section (active list name + item count, Rename / Delete only for a user
    list) and the card grid.

    The page is full width on purpose: there is no content MaxWidth, so the ItemsWrapGrid below wraps
    cards across the whole area left of the sidebar instead of stopping at a fixed column.
-->
<Page
    x:Class="TBDMovies.UI.Views.MyListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TBDMovies.UI.Controls"
    xmlns:models="using:TBDMovies.UI.Models"
    xmlns:local="using:TBDMovies.UI.Views"
    Background="Transparent">


    <!--
        The card grid owns its own scroll so its ItemsWrapGrid virtualizes; nesting a GridView in the page
        ScrollViewer realizes every card at once. Header, tabs and the active-list action row sit in a
        fixed Auto row; the grid fills the * row and scrolls internally.
    -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Padding="32,32,32,0"
            Spacing="20">
            <!--
                Page header: title and list count on leading edge, SearchBox on trailing edge.
            -->
            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock
                        x:Name="PageTitleText"
                        Style="{StaticResource TitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ListsCountText"
                        Margin="0,0,0,2"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SecondaryCaptionTextStyle}" />
                </StackPanel>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Width="260"
                    QueryIcon="Find"
                    CornerRadius="8"
                    Style="{StaticResource PageSearchBoxStyle}"
                    TextChanged="SearchBox_TextChanged" />
            </Grid>

            <!--
                List selector capsules taking full width with automatic wrapping (no horizontal scrollbar).
            -->
            <controls:WrapPanel
                x:Name="ListSelector"
                Orientation="Horizontal"
                ColumnSpacing="6"
                RowSpacing="8"
                HorizontalAlignment="Stretch">
                <RadioButton
                    x:Name="WatchLaterItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    IsChecked="True"
                    Style="{StaticResource TabPillItemStyle}"
                    Tag="watch-later">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xE8FD;" />
                        <TextBlock x:Name="WatchLaterLabel" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="WatchLaterCount"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="FavoritesItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    Style="{StaticResource TabPillItemStyle}"
                    Tag="favorites">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xEB51;" />
                        <TextBlock x:Name="FavoritesLabel" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="FavoritesCount"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="ContinueWatchingItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    Style="{StaticResource TabPillItemStyle}"
                    Tag="continue-watching">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE768;" />
                        <TextBlock x:Name="ContinueWatchingLabel" VerticalAlignment="Center" />
                        <TextBlock x:Name="ContinueWatchingCount" VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionTextStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="RecentlyWatchedItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    Style="{StaticResource TabPillItemStyle}"
                    Tag="recently-watched">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE81C;" />
                        <TextBlock x:Name="RecentlyWatchedLabel" VerticalAlignment="Center" />
                        <TextBlock x:Name="RecentlyWatchedCount" VerticalAlignment="Center" Style="{StaticResource SecondaryCaptionTextStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="TraktTabItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    Style="{StaticResource TabPillItemStyle}"
                    Tag="trakt">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xE8BD;" />
                        <TextBlock x:Name="TraktTabLabel" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="TraktTabCount"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </RadioButton>
                <Button
                    x:Name="NewListButton"
                    Click="NewListButton_Click"
                    Style="{StaticResource AccentControlButtonStyle}"
                    CornerRadius="8"
                    Height="32"
                    Padding="14,0,14,0"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Glyph="&#xE710;" />
                        <TextBlock x:Name="NewListButtonText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </controls:WrapPanel>

            <Border
                x:Name="TraktRow"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MinHeight="48"
                Padding="12,8"
                Margin="0,4,0,4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="#ED2224"
                        CornerRadius="8"
                        Padding="10,4"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" Glyph="&#xE8BD;" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="TRAKT HUB" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" CharacterSpacing="20" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer
                        Grid.Column="1"
                        x:Name="TraktPlaylistsScroll"
                        HorizontalScrollMode="Enabled"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <StackPanel
                                x:Name="TraktPlaylistsSelector"
                                Style="{StaticResource TabStripStyle}" />
                            <Button
                                x:Name="NewTraktListButton"
                                Click="NewTraktListButton_Click"
                                Style="{StaticResource AccentControlButtonStyle}"
                                CornerRadius="8"
                                Height="28"
                                Padding="10,0,10,0"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="10" Glyph="&#xE710;" />
                                    <TextBlock x:Name="NewTraktListButtonText" Text="New Trakt List" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Button
                        x:Name="SyncTraktButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="SyncTraktButton_Click"
                        Style="{StaticResource DefaultButtonStyle}"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        MinHeight="32"
                        Padding="12,4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" Glyph="&#xE72C;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SyncTraktButtonText" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!--  Active list: count on leading edge, Add Media & More Options on trailing edge.  -->
            <Grid ColumnSpacing="12" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="ListNameText"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />
                    <TextBlock x:Name="ListCountText" Style="{StaticResource SecondaryCaptionTextStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="AddMoviesButton"
                        Click="AddMoviesButton_Click"
                        Style="{StaticResource AccentControlButtonStyle}"
                        CornerRadius="8"
                        Height="32">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Glyph="&#xE710;" />
                            <TextBlock x:Name="AddMoviesButtonText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ListMoreOptionsButton"
                        Style="{StaticResource SubtleControlButtonStyle}"
                        Height="32" Width="36" Padding="0"
                        VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="RenameListMenuItem" Click="RenameListButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="DeleteListMenuItem" Click="DeleteListButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
            <controls:EmptyStateCard
                x:Name="EmptyState"
                Margin="32,24,32,40"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsFrameless="True"
                ActionClick="EmptyStateAction_Click"
                Glyph="&#xE728;"
                Visibility="Collapsed" />

            <GridView
                x:Name="ListGrid"
                Padding="32,12,32,48"
                HorizontalAlignment="Stretch"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                ItemClick="ListGrid_ItemClick"
                ItemTemplate="{StaticResource ListMovieCardTemplate}"
                ContextRequested="MediaGrid_ContextRequested"
                Style="{StaticResource MediaGridViewStyle}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid x:Name="ListItemsPanel" ItemWidth="{StaticResource MediaCardItemWidth}" ItemHeight="{StaticResource MediaCardItemHeight}" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>

            <GridView
                x:Name="ContinueGrid"
                Padding="32,12,32,48"
                HorizontalAlignment="Stretch"
                ItemClick="ActivityGrid_ItemClick"
                ContextRequested="MediaGrid_ContextRequested"
                Style="{StaticResource MediaGridViewStyle}"
                Visibility="Collapsed"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid x:Name="ContinueWatchingItemsPanel" ItemWidth="{StaticResource MediaCardItemWidth}" ItemHeight="{StaticResource MediaCardItemHeight}" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:HomeActivityCard">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="{StaticResource MediaCardPosterWidth}"
                                Height="{StaticResource MediaCardPosterHeight}"
                                HorizontalAlignment="Center"
                                Style="{StaticResource PosterSurfaceStyle}">
                                <Grid>
                                    <FontIcon FontSize="36" Glyph="&#xE8B2;" Foreground="{ThemeResource PosterGlyphForegroundBrush}" />
                                    <Image Source="{x:Bind PosterSource, Mode=OneWay}" Stretch="UniformToFill" />
                                    <!-- Green Continue Watching Progress Bar along the bottom of the poster -->
                                    <ProgressBar
                                        VerticalAlignment="Bottom"
                                        Height="4"
                                        Value="60"
                                        Maximum="100"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Background="Transparent"
                                        CornerRadius="0,0,8,8" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="6,0,6,14" Spacing="2">
                                <TextBlock
                                    Height="{StaticResource MediaCardTitleHeight}"
                                    MaxLines="2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind SecondaryLine}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <GridView
                x:Name="HistoryGrid"
                Padding="32,12,32,48"
                HorizontalAlignment="Stretch"
                ItemClick="ActivityGrid_ItemClick"
                ContextRequested="MediaGrid_ContextRequested"
                Style="{StaticResource MediaGridViewStyle}"
                Visibility="Collapsed"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid x:Name="HistoryItemsPanel" ItemWidth="{StaticResource MediaCardItemWidth}" ItemHeight="{StaticResource MediaCardItemHeight}" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:WatchHistoryCardRecord">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="{StaticResource MediaCardPosterWidth}"
                                Height="{StaticResource MediaCardPosterHeight}"
                                HorizontalAlignment="Center"
                                Style="{StaticResource PosterSurfaceStyle}">
                                <Grid>
                                    <FontIcon FontSize="36" Glyph="&#xE8B2;" Foreground="{ThemeResource PosterGlyphForegroundBrush}" />
                                    <Image Source="{x:Bind ArtworkSource, Mode=OneWay}" Stretch="UniformToFill" />
                                    <Border
                                        Margin="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Padding="6,2"
                                        Visibility="{x:Bind local:HomePage.UnavailableVisibility(IsAvailable)}">
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind AvailabilityText}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="6,0,6,14" Spacing="2">
                                <TextBlock
                                    Height="{StaticResource MediaCardTitleHeight}"
                                    MaxLines="2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind Context}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Style="{StaticResource TertiaryCaptionTextStyle}"
                                    Text="{x:Bind WatchedAt}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
