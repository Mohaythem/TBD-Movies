<!--
    My Lists.

    Mirrors PersonalLibrary.tsx: a page header (title + list count + accent New List) with the page
    search directly beneath it, the four-list tab strip where the active tab also shows its item
    count, then the list section (active list name + item count, Rename / Delete only for a user
    list) and the card grid.

    The page is full width on purpose: there is no content MaxWidth, so the ItemsWrapGrid below wraps
    cards across the whole area left of the sidebar instead of stopping at a fixed column.
-->
<Page
    x:Class="TBDMovies.UI.Views.MyListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TBDMovies.UI.Controls"
    xmlns:models="using:TBDMovies.UI.Models"
    xmlns:local="using:TBDMovies.UI.Views"
    Background="Transparent">


    <!--
        The card grid owns its own scroll so its ItemsWrapGrid virtualizes; nesting a GridView in the page
        ScrollViewer realizes every card at once. Header, tabs and the active-list action row sit in a
        fixed Auto row; the grid fills the * row and scrolls internally.
    -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Padding="32,32,32,0"
            Spacing="20">
            <!--
                Page header: title on leading edge, Trakt sync capsule & SearchBox on trailing edge.
            -->
            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="PageTitleText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">

                    <!-- Trakt Sync Status Capsule -->
                    <controls:TraktSyncCapsule
                        x:Name="TraktSync"
                        VerticalAlignment="Center" />

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        VerticalAlignment="Center"
                        Width="240"
                        QueryIcon="Find"
                        CornerRadius="8"
                        Style="{StaticResource PageSearchBoxStyle}"
                        TextChanged="SearchBox_TextChanged" />
                </StackPanel>
            </Grid>

            <!--
                List selector capsules taking full width with automatic wrapping (no horizontal scrollbar).
            -->
            <controls:WrapPanel
                x:Name="ListSelector"
                Orientation="Horizontal"
                ColumnSpacing="6"
                RowSpacing="8"
                HorizontalAlignment="Stretch">
                <RadioButton
                    x:Name="WatchLaterItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    IsChecked="True"
                    Style="{StaticResource TabPillItemStyle}"
                    Tag="watch-later">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="WatchLaterLabel" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="WatchLaterCount"
                            VerticalAlignment="Center"
                            Style="{StaticResource TabPillBadgeStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="FavoritesItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    Style="{StaticResource TabPillItemStyle}"
                    Tag="favorites">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="FavoritesLabel" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="FavoritesCount"
                            VerticalAlignment="Center"
                            Style="{StaticResource TabPillBadgeStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="ContinueWatchingItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    Style="{StaticResource TabPillItemStyle}"
                    Tag="continue-watching">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="ContinueWatchingLabel" VerticalAlignment="Center" />
                        <TextBlock x:Name="ContinueWatchingCount" VerticalAlignment="Center" Style="{StaticResource TabPillBadgeStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="RecentlyWatchedItem"
                    Checked="ListTab_Checked"
                    GroupName="MyListsSelector"
                    Style="{StaticResource TabPillItemStyle}"
                    Tag="recently-watched">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="RecentlyWatchedLabel" VerticalAlignment="Center" />
                        <TextBlock x:Name="RecentlyWatchedCount" VerticalAlignment="Center" Style="{StaticResource TabPillBadgeStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </RadioButton>
                <Rectangle
                    x:Name="TabsSeparator"
                    Width="1"
                    Height="20"
                    Margin="4,8,4,8"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Opacity="0.4"
                    Visibility="Collapsed" />
                <Button
                    x:Name="NewListButton"
                    Click="NewListButton_Click"
                    Style="{StaticResource DefaultButtonStyle}"
                    CornerRadius="8"
                    Height="36"
                    Padding="14,0,14,0"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Glyph="&#xE710;" />
                        <TextBlock x:Name="NewListButtonText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </controls:WrapPanel>

            <InfoBar
                x:Name="TraktFavoritesLimitInfoBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Warning" />

            <!--  Active list: count on leading edge, Add Media & More Options on trailing edge.  -->
            <Grid ColumnSpacing="12" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Name="ListNameText"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="ListHeadingSeparator"
                        Text="·"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Opacity="0.4"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="ListCountText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Opacity="0.7"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="AddMoviesButton"
                        Click="AddMoviesButton_Click"
                        Style="{StaticResource AccentControlButtonStyle}"
                        CornerRadius="8"
                        Height="32">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Glyph="&#xE710;" />
                            <TextBlock x:Name="AddMoviesButtonText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ListMoreOptionsButton"
                        Style="{StaticResource SubtleControlButtonStyle}"
                        Height="32" Width="36" Padding="0"
                        VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="RenameListMenuItem" Click="RenameListButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="DeleteListMenuItem" Click="DeleteListButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
            <controls:EmptyStateCard
                x:Name="EmptyState"
                Margin="32,24,32,40"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsFrameless="True"
                ActionClick="EmptyStateAction_Click"
                Glyph="&#xE728;"
                Visibility="Collapsed" />

            <GridView
                x:Name="ListGrid"
                Padding="32,12,32,48"
                HorizontalAlignment="Stretch"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                ItemClick="ListGrid_ItemClick"
                ItemTemplate="{StaticResource ListMovieCardTemplate}"
                ContextRequested="MediaGrid_ContextRequested"
                Style="{StaticResource MediaGridViewStyle}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid x:Name="ListItemsPanel" ItemWidth="{StaticResource MediaCardItemWidth}" ItemHeight="{StaticResource MediaCardItemHeight}" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>

            <GridView
                x:Name="ContinueGrid"
                Padding="32,12,32,48"
                HorizontalAlignment="Stretch"
                ItemClick="ActivityGrid_ItemClick"
                ContextRequested="MediaGrid_ContextRequested"
                Style="{StaticResource MediaGridViewStyle}"
                Visibility="Collapsed"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid x:Name="ContinueWatchingItemsPanel" ItemWidth="{StaticResource MediaCardItemWidth}" ItemHeight="{StaticResource MediaCardItemHeight}" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:HomeActivityCard">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="{StaticResource MediaCardPosterWidth}"
                                Height="{StaticResource MediaCardPosterHeight}"
                                HorizontalAlignment="Center"
                                Style="{StaticResource PosterSurfaceStyle}">
                                <Grid>
                                    <FontIcon FontSize="36" Glyph="&#xE8B2;" Foreground="{ThemeResource PosterGlyphForegroundBrush}" />
                                    <Image Source="{x:Bind PosterSource, Mode=OneWay}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="6,0,6,14" Spacing="2">
                                <TextBlock
                                    Height="{StaticResource MediaCardTitleHeight}"
                                    MaxLines="2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind SecondaryLine}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <GridView
                x:Name="HistoryGrid"
                Padding="32,12,32,48"
                HorizontalAlignment="Stretch"
                ItemClick="ActivityGrid_ItemClick"
                ContextRequested="MediaGrid_ContextRequested"
                Style="{StaticResource MediaGridViewStyle}"
                Visibility="Collapsed"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid x:Name="HistoryItemsPanel" ItemWidth="{StaticResource MediaCardItemWidth}" ItemHeight="{StaticResource MediaCardItemHeight}" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:WatchHistoryCardRecord">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="{StaticResource MediaCardPosterWidth}"
                                Height="{StaticResource MediaCardPosterHeight}"
                                HorizontalAlignment="Center"
                                Style="{StaticResource PosterSurfaceStyle}">
                                <Grid>
                                    <FontIcon FontSize="36" Glyph="&#xE8B2;" Foreground="{ThemeResource PosterGlyphForegroundBrush}" />
                                    <Image Source="{x:Bind ArtworkSource, Mode=OneWay}" Stretch="UniformToFill" />
                                    <Border
                                        Margin="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Padding="6,2"
                                        Visibility="{x:Bind local:HomePage.UnavailableVisibility(IsAvailable)}">
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind AvailabilityText}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="6,0,6,14" Spacing="2">
                                <TextBlock
                                    Height="{StaticResource MediaCardTitleHeight}"
                                    MaxLines="2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind Context}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Style="{StaticResource TertiaryCaptionTextStyle}"
                                    Text="{x:Bind WatchedAt}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
