<Page
    x:Class="TBDMovies.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TBDMovies.UI.Models"
    Background="Transparent">

    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageContentMaxWidth}" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="24">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="AppVersionText" Style="{StaticResource SecondaryCaptionTextStyle}" FlowDirection="LeftToRight" TextWrapping="Wrap" />
                </StackPanel>

                <SelectorBar x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged">
                    <SelectorBarItem x:Name="TabGeneralItem" Tag="general" />
                    <SelectorBarItem x:Name="TabLibraryItem" Tag="library" />
                    <SelectorBarItem x:Name="TabIntegrationsItem" Tag="integrations" />
                    <SelectorBarItem x:Name="TabDataItem" Tag="data" />
                </SelectorBar>

                <StackPanel x:Name="GeneralSectionPanel" Spacing="24">
                <!--  Appearance: the section heading sits above its card, like the design source.  -->
                <StackPanel Spacing="12">
                    <TextBlock x:Name="AppearanceHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ThemeLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="ThemeHelpText"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="ThemeSelector"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    SelectionChanged="ThemeSelector_SelectionChanged"
                                    Style="{StaticResource NarrowSelectStyle}">
                                    <ComboBoxItem x:Name="ThemeDarkItem" Content="Dark" Tag="dark" />
                                    <ComboBoxItem x:Name="ThemeLightItem" Content="Light" Tag="light" />
                                </ComboBox>
                            </Grid>

                            <Border Style="{StaticResource HairlineDividerStyle}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="LanguageLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="LanguageHelpText"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="LanguageSelector"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    SelectionChanged="LanguageSelector_SelectionChanged"
                                    Style="{StaticResource NarrowSelectStyle}">
                                    <ComboBoxItem x:Name="LanguageEnglishItem" Tag="en" />
                                    <ComboBoxItem x:Name="LanguageArabicItem" Tag="ar" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Media Player  -->
                <StackPanel Spacing="12">
                    <TextBlock x:Name="MediaPlayerHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="MediaPlayerLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="MediaPlayerHelpText"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="PlayerSelector"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    SelectionChanged="PlayerSelector_SelectionChanged"
                                    Style="{StaticResource NarrowSelectStyle}">
                                    <ComboBoxItem x:Name="PlayerDefaultItem" Tag="default" />
                                    <ComboBoxItem x:Name="PlayerVlcItem" Tag="vlc" />
                                    <ComboBoxItem x:Name="PlayerMpcItem" Tag="mpc" />
                                    <ComboBoxItem x:Name="PlayerMpvItem" Tag="mpv" />
                                    <ComboBoxItem x:Name="PlayerCustomItem" Tag="custom" />
                                </ComboBox>
                            </Grid>

                            <StackPanel x:Name="CustomPlayerPanel" Visibility="Collapsed" Spacing="12">
                                <Border Style="{StaticResource HairlineDividerStyle}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="CustomPlayerPathBox"
                                        TextChanged="CustomPlayerPathBox_TextChanged"
                                        PlaceholderText="C:\Path\To\Player.exe"
                                        Style="{StaticResource FormInputTextBoxStyle}" />
                                    <Button
                                        x:Name="BrowseCustomPlayerButton"
                                        Grid.Column="1"
                                        Click="BrowseCustomPlayerButton_Click"
                                        Style="{StaticResource SubtleControlButtonStyle}"
                                        Content="Browse…" />
                                </Grid>
                                <TextBox
                                    x:Name="CustomPlayerArgsBox"
                                    TextChanged="CustomPlayerArgsBox_TextChanged"
                                    PlaceholderText="&quot;{path}&quot; --start={seconds}"
                                    Style="{StaticResource FormInputTextBoxStyle}" />
                                <TextBlock
                                    x:Name="CustomPlayerArgsHelpText"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                </StackPanel>

                <StackPanel x:Name="LibrarySectionPanel" Spacing="24" Visibility="Collapsed">
                <!--  Library folders  -->
                <StackPanel Spacing="12">
                    <TextBlock x:Name="LibraryHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="MediaFoldersLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="MediaFoldersHelpText"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="AddMediaFolderButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="AddMediaFolder_Click"
                                    Style="{StaticResource AccentControlButtonStyle}" />
                            </Grid>

                            <TextBlock
                                x:Name="MediaFoldersEmptyText"
                                Style="{StaticResource TertiaryCaptionTextStyle}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />

                            <ItemsRepeater x:Name="MediaFoldersRepeater">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:MediaFolderRow">
                                        <Border Style="{StaticResource RowDividerStyle}">
                                            <Grid ColumnSpacing="12" MinHeight="48">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    IsTextSelectionEnabled="True"
                                                    Style="{StaticResource SecondaryBodyTextStyle}"
                                                    Text="{x:Bind Path}"
                                                    TextWrapping="Wrap" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                                    <Button
                                                        Click="ReplaceMediaFolder_Click"
                                                        Content="{x:Bind ReplaceLabel}"
                                                        Tag="{x:Bind Path}"
                                                        Style="{StaticResource SubtleControlButtonStyle}" />
                                                    <Button
                                                        Click="RemoveMediaFolder_Click"
                                                        Content="{x:Bind RemoveLabel}"
                                                        Tag="{x:Bind Path}"
                                                        Style="{StaticResource SubtleControlButtonStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Border Style="{StaticResource HairlineDividerStyle}" />

                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="InboundAutoScanLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            x:Name="InboundAutoScanHelpText"
                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="InboundAutoScanToggle"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        MinWidth="0"
                                        OnContent=""
                                        OffContent=""
                                        Toggled="InboundAutoScanToggle_Toggled" />
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="InboundFolderLabelText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                                        <TextBlock
                                            x:Name="InboundFolderPathText"
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource SecondaryBodyTextStyle}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        x:Name="BrowseInboundFolderButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="BrowseInboundFolderButton_Click"
                                        Style="{StaticResource SubtleControlButtonStyle}" />
                                    <Button
                                        x:Name="ClearInboundFolderButton"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Click="ClearInboundFolderButton_Click"
                                        Style="{StaticResource SubtleControlButtonStyle}" />
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="InboundIgnoredCountText"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource TertiaryCaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="ClearInboundIgnoredButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="ClearInboundIgnoredButton_Click"
                                        Style="{StaticResource SubtleControlButtonStyle}" />
                                </Grid>
                            </StackPanel>

                            <Border Style="{StaticResource HairlineDividerStyle}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ExportMoviesLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="ExportMoviesHelpText"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="ExportMoviesButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="ExportMoviesButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                        <TextBlock x:Name="ExportMoviesButtonText" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <InfoBar
                                x:Name="ExportFeedbackInfoBar"
                                IsOpen="False"
                                Severity="Success"
                                IsClosable="True">
                                <InfoBar.ActionButton>
                                    <Button
                                        x:Name="OpenExportedFolderButton"
                                        Click="OpenExportedFolderButton_Click"
                                        Style="{StaticResource SubtleControlButtonStyle}" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </StackPanel>

                <StackPanel x:Name="IntegrationsSectionPanel" Spacing="24" Visibility="Collapsed">
                <!--  TMDB  -->
                <StackPanel Spacing="12">
                    <TextBlock x:Name="TmdbHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="TmdbStatusPill"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource StatusPillStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Grid Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse x:Name="TmdbConnectedDot" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <Ellipse x:Name="TmdbMissingDot" Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Grid>
                                        <TextBlock x:Name="TmdbStatusText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock
                                x:Name="TmdbStatusHelpText"
                                Style="{StaticResource SecondaryBodyTextStyle}"
                                TextWrapping="Wrap" />

                            <Border Style="{StaticResource HairlineDividerStyle}" />

                            <StackPanel x:Name="TokenInputPanel" Visibility="Collapsed" Spacing="6">
                                <TextBlock x:Name="TokenLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="TokenHelpText"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    TextWrapping="Wrap" />
                                <PasswordBox x:Name="TokenBox" PasswordRevealMode="Hidden" Style="{StaticResource FormInputPasswordBoxStyle}" />
                            </StackPanel>

                            <InfoBar x:Name="TmdbFeedback" IsOpen="False" Severity="Warning" IsClosable="True" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="ChangeTokenButton"
                                    Click="ChangeTokenButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}" />
                                <Button
                                    x:Name="UseTokenButton"
                                    Click="UseTokenButton_Click"
                                    Style="{StaticResource AccentControlButtonStyle}" />
                                <Button
                                    x:Name="CancelTokenButton"
                                    Click="CancelTokenButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}" />
                                <Button
                                    x:Name="ClearTokenButton"
                                    Click="ClearTokenButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}" />
                                <Button
                                    x:Name="TestConnectionButton"
                                    Click="TestConnectionButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}" />
                                <Button
                                    x:Name="SetupGuideButton"
                                    Click="SetupGuideButton_Click"
                                    Style="{StaticResource TextActionButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Trakt  -->
                <StackPanel Spacing="12">
                    <TextBlock x:Name="TraktHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="TraktStatusPill"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource StatusPillStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Grid Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse x:Name="TraktConnectedDot" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                                            <Ellipse x:Name="TraktSyncingDot" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                                            <Ellipse x:Name="TraktDisconnectedDot" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="Visible" />
                                        </Grid>
                                        <TextBlock x:Name="TraktStatusText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock x:Name="TraktAccountInfoText" Style="{StaticResource SecondaryBodyTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="TraktSyncInfoText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="TraktErrorText" Style="{StaticResource SecondaryCaptionTextStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>

                            <Border Style="{StaticResource HairlineDividerStyle}" />

                            <!-- Registration parameters stay hidden after saving. They are shown only for first-time setup or explicit edit. -->
                            <StackPanel x:Name="TraktConfigSummaryPanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="TraktConfigSummaryText" Style="{StaticResource SecondaryBodyTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="TraktClientIdMaskedText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                                <Button x:Name="TraktEditConfigButton" Click="TraktEditConfigButton_Click" Style="{StaticResource SubtleControlButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel x:Name="TraktConfigInputPanel" Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="TraktClientIdLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="TraktClientIdHelpText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                                    <PasswordBox x:Name="TraktClientIdBox" PasswordRevealMode="Hidden" Style="{StaticResource FormInputPasswordBoxStyle}" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="TraktRedirectUriLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="TraktRedirectUriHelpText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                                    <TextBox x:Name="TraktRedirectUriBox" Style="{StaticResource FormInputTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="TraktSaveConfigButton" Click="TraktSaveConfigButton_Click" Style="{StaticResource AccentControlButtonStyle}" />
                                    <Button x:Name="TraktCancelConfigButton" Click="TraktCancelConfigButton_Click" Style="{StaticResource SubtleControlButtonStyle}" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Device Code Authorization Panel (Active during device flow) -->
                            <StackPanel x:Name="TraktDeviceAuthPanel" Spacing="12" Visibility="Collapsed">
                                <Border Style="{StaticResource HairlineDividerStyle}" />
                                <TextBlock x:Name="TraktDeviceAuthHeadingText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="TraktDeviceAuthInstructionsText" Style="{StaticResource SecondaryBodyTextStyle}" TextWrapping="Wrap" />
                                <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,8" HorizontalAlignment="Left">
                                    <TextBlock x:Name="TraktUserCodeText" Style="{StaticResource SubtitleTextBlockStyle}" FontFamily="Consolas, Cascadia Mono, monospace" IsTextSelectionEnabled="True" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="TraktOpenVerificationUrlButton" Click="TraktOpenVerificationUrlButton_Click" Style="{StaticResource TextActionButtonStyle}" />
                                    <Button x:Name="TraktCancelAuthButton" Click="TraktCancelAuthButton_Click" Style="{StaticResource SubtleControlButtonStyle}" />
                                </StackPanel>
                                <ProgressBar x:Name="TraktAuthPollingProgressBar" IsIndeterminate="True" Height="2" />
                            </StackPanel>

                            <InfoBar x:Name="TraktFeedback" IsOpen="False" Severity="Informational" IsClosable="True" />

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="TraktConnectButton" Click="TraktConnectButton_Click" Style="{StaticResource AccentControlButtonStyle}" />
                                <Button x:Name="TraktSyncNowButton" Click="TraktSyncNowButton_Click" Style="{StaticResource SubtleControlButtonStyle}" />
                                <Button x:Name="TraktDisconnectButton" Click="TraktDisconnectButton_Click" Style="{StaticResource DangerControlButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Subtitles (SubDL)  -->
                <StackPanel Spacing="12">
                    <TextBlock x:Name="SubtitlesHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="SubDlStatusPill"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource StatusPillStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Grid Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse x:Name="SubDlConnectedDot" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                                            <Ellipse x:Name="SubDlMissingDot" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="Visible" />
                                        </Grid>
                                        <TextBlock x:Name="SubDlStatusText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock x:Name="SubDlApiKeyLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="SubDlApiKeyHelpText"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <PasswordBox x:Name="SubDlApiKeyBox" PasswordRevealMode="Hidden" Style="{StaticResource FormInputPasswordBoxStyle}" />

                            <InfoBar x:Name="SubDlFeedback" IsOpen="False" Severity="Success" IsClosable="True" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="SaveSubDlApiKeyButton"
                                    Click="SaveSubDlApiKeyButton_Click"
                                    Style="{StaticResource AccentControlButtonStyle}">
                                    <TextBlock x:Name="SaveSubDlApiKeyButtonText" />
                                </Button>
                                <Button
                                    x:Name="RemoveSubDlApiKeyButton"
                                    Click="RemoveSubDlApiKeyButton_Click"
                                    Visibility="Collapsed"
                                    Style="{StaticResource SubtleControlButtonStyle}">
                                    <TextBlock x:Name="RemoveSubDlApiKeyButtonText" />
                                </Button>
                                <Button
                                    x:Name="GetSubDlKeyButton"
                                    Click="GetSubDlKeyButton_Click"
                                    Style="{StaticResource TextActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                        <TextBlock x:Name="GetSubDlKeyButtonText" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                </StackPanel>

                <StackPanel x:Name="DataSectionPanel" Spacing="24" Visibility="Collapsed">
                <!--  Storage and advanced details  -->
                <StackPanel Spacing="12">
                    <TextBlock x:Name="StorageAdvancedHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="DataFolderLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="DataFolderPathText" Style="{StaticResource TertiaryCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DataFolderHelpText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="OpenDataFolderButton" Grid.Column="1" VerticalAlignment="Center" Click="OpenDataFolderButton_Click" Style="{StaticResource SubtleControlButtonStyle}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  History and recovery  -->
                <StackPanel Spacing="12">
                    <TextBlock x:Name="HistoryHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="ViewLogLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="HistoryHelpText"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="ViewLogButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="ViewLogButton_Click"
                                Style="{StaticResource SubtleControlButtonStyle}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  Database & Safety Backups  -->
                <StackPanel Spacing="12">
                    <TextBlock x:Name="DatabaseBackupsHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <!-- Create verified backup row -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="CreateBackupLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="CreateBackupHelpText"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="CreateBackupButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="CreateBackupButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="14"
                                            Glyph="&#xE74E;" />
                                        <TextBlock x:Name="CreateBackupButtonText" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <MenuFlyoutSeparator />

                            <!-- Restore backup row -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="RestoreBackupLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="RestoreBackupHelpText"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="RestoreBackupButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SubtleControlButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="14"
                                            Glyph="&#xE777;" />
                                        <TextBlock x:Name="RestoreBackupButtonText" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="AvailableBackupsFlyout" Opening="AvailableBackupsFlyout_Opening" />
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Danger zone  -->
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="DangerHeadingText"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Style="{StaticResource DangerCardBorderStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ClearHistoryLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="ClearHistoryHelpText"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="ClearHistoryButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="ClearHistoryButton_Click"
                                    Style="{StaticResource DangerControlButtonStyle}" />
                            </Grid>

                            <Border Style="{StaticResource HairlineDividerStyle}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ClearLibraryLabelText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        x:Name="ClearLibraryHelpText"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="ClearLibraryButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="ClearLibraryButton_Click"
                                    Style="{StaticResource DangerControlButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
