<Page
    x:Class="TBDMovies.UI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TBDMovies.UI.Views"
    xmlns:models="using:TBDMovies.UI.Models"
    Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="HomeHeroButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <DataTemplate x:Key="ContinueWatchingTemplate" x:DataType="models:HomeActivityCard">
                <Grid Width="320" Height="196">
                    <Button
                        Width="320" Height="196"
                        AutomationProperties.AutomationId="{x:Bind DetailsAutomationId}"
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        Click="ContinueDetails_Click"
                        Style="{StaticResource HomeHeroButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="{x:Bind Title}">
                        <Border CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid Width="320" Height="196" Background="{ThemeResource PosterMoviePlaceholderBrush}">
                                <FontIcon Margin="0,0,0,64" FontSize="40" Glyph="&#xE8B2;"
                                          Foreground="{ThemeResource PosterGlyphForegroundBrush}" />
                                <Image Height="196" Source="{x:Bind ArtworkSource, Mode=OneWay}"
                                       Stretch="UniformToFill" />
                                <Image Width="96" Height="144" Margin="12,8,12,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Source="{x:Bind PosterSource, Mode=OneWay}"
                                       Visibility="{x:Bind PosterVisibility, Mode=OneWay}"
                                       Stretch="Uniform" />
                                <Border Background="{ThemeResource LandscapeCardScrimBrush}" />
                                <Grid Margin="16,68,16,16" ColumnSpacing="12" VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Foreground="{ThemeResource LandscapeCardTextBrush}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Text="{x:Bind Title}" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}"
                                                   Style="{StaticResource SecondaryCaptionTextStyle}"
                                                   Text="{x:Bind SecondaryLine}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}"
                                                   Style="{StaticResource SecondaryCaptionTextStyle}"
                                                   Text="{x:Bind TypeLabel}" />
                                    </StackPanel>
                                    <!-- Reserves the real Play button's space in both LTR and RTL. -->
                                    <Border Grid.Column="1" MinWidth="76" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>
                    <Button Margin="16" AutomationProperties.AutomationId="{x:Bind PlayAutomationId}"
                            AutomationProperties.Name="{x:Bind PlayLabel}" Click="ContinuePlay_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            IsEnabled="{x:Bind PlayEnabled, Mode=OneWay}"
                            Style="{StaticResource AccentControlButtonStyle}"
                            Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind PlayLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE768;" />
                            <TextBlock Text="{x:Bind PlayLabel}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="WatchHistoryTemplate" x:DataType="models:WatchHistoryCardRecord">
                <Grid Width="320" Height="196">
                    <Button
                        Width="320" Height="196"
                        AutomationProperties.AutomationId="{x:Bind local:HomePage.HistoryAutomationId(EventId)}"
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        Click="HistoryCard_Click"
                        Style="{StaticResource HomeHeroButtonStyle}"
                        Tag="{x:Bind}">
                        <Border CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid Width="320" Height="196" Background="{ThemeResource PosterMoviePlaceholderBrush}">
                                <FontIcon Margin="0,0,0,64" FontSize="40"
                                          Foreground="{ThemeResource PosterGlyphForegroundBrush}"
                                          Glyph="&#xE8B2;" />
                                <Image Height="196" Source="{x:Bind ArtworkSource, Mode=OneWay}"
                                       Stretch="UniformToFill" />
                                <Border Background="{ThemeResource LandscapeCardScrimBrush}" />
                                <Grid Margin="16,68,16,16" VerticalAlignment="Bottom">
                                    <StackPanel Spacing="4">
                                        <TextBlock Foreground="{ThemeResource LandscapeCardTextBrush}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Text="{x:Bind Title}" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}"
                                                   Style="{StaticResource SecondaryCaptionTextStyle}"
                                                   Text="{x:Bind Context}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Foreground="{ThemeResource LandscapeCardSecondaryTextBrush}"
                                                   Style="{StaticResource TertiaryCaptionTextStyle}"
                                                   Text="{x:Bind local:HomePage.HistoryMetaLine(WatchedAt, MediaKind)}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Text="{x:Bind AvailabilityText}"
                                                   Visibility="{x:Bind local:HomePage.UnavailableVisibility(IsAvailable)}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <!--
        Padding lives on the ScrollViewer and the content is a single stretched column, so Home fills
        the whole area left of the sidebar. Media shelves keep one row of fixed-size cards, clipped
        at the viewport edge. There is deliberately no content MaxWidth here - one used to cap the page at
        1040 epx, which is what left the right half of a wide window empty.
    -->
    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="32">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="PageSubtitleText" Style="{StaticResource SecondaryBodyTextStyle}" />
                </StackPanel>

                <!-- State 1: Empty Library Onboarding -->
                <Border
                    x:Name="OnboardingCard"
                    MaxWidth="640"
                    HorizontalAlignment="Center"
                    Padding="32"
                    CornerRadius="12"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="Collapsed">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="OnboardingTitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="OnboardingSubtitleText" Style="{StaticResource SecondaryBodyTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Style="{StaticResource HairlineDividerStyle}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="OnboardingStep1TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="OnboardingStep1DescText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="OnboardingAddMediaButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OnboardingAddMedia_Click"
                                Style="{StaticResource AccentControlButtonStyle}" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="OnboardingStep2TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="OnboardingStep2DescText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="OnboardingSettingsButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OnboardingSettings_Click"
                                Style="{StaticResource SubtleControlButtonStyle}" />
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="OnboardingStep3TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="OnboardingStep3DescText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- State 2: Continue Watching Shelf -->
                <StackPanel x:Name="ContinueSection" Spacing="12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ContinueHeadingText" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button x:Name="ContinueSeeAllButton" Grid.Column="1" VerticalAlignment="Center" Click="ContinueSeeAllButton_Click" Style="{StaticResource TextBlockButtonStyle}" />
                    </Grid>
                    <Grid x:Name="ContinueRowGrid" Height="196">
                        <ItemsRepeater
                            x:Name="ContinueRepeater"
                            HorizontalAlignment="Left"
                            ItemTemplate="{StaticResource ContinueWatchingTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="12" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Grid>
                </StackPanel>

                <!-- State 3: Promoted Watchlist Shelf -->
                <StackPanel x:Name="WatchlistSection" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="WatchlistHeadingText"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button
                            x:Name="WatchlistSeeAllButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="WatchlistSeeAllButton_Click"
                            Style="{StaticResource TextBlockButtonStyle}" />
                    </Grid>
                    <Grid x:Name="WatchlistRowGrid" Height="326">
                        <GridView
                            x:Name="WatchlistGrid"
                            ItemClick="WatchlistGrid_ItemClick"
                            ItemTemplate="{StaticResource MovieCardTemplate}"
                            Style="{StaticResource MediaGridViewStyle}">
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection />
                            </GridView.ItemContainerTransitions>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        ItemHeight="{StaticResource MediaCardItemHeight}"
                                        ItemWidth="{StaticResource MediaCardItemWidth}"
                                        MaximumRowsOrColumns="1"
                                        Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </Grid>
                </StackPanel>

                <!-- State 4: Compact Fluent Action Strip -->
                <Border
                    x:Name="CompactStripCard"
                    MinHeight="54"
                    Padding="16,12"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE768;" />
                        <TextBlock
                            x:Name="CompactStripMessageText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryBodyTextStyle}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="CompactOpenLibraryButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="CompactOpenLibraryButton_Click"
                            Style="{StaticResource AccentControlButtonStyle}" />
                    </Grid>
                </Border>

                <!-- Watch History Shelf -->
                <StackPanel x:Name="HistorySection" Spacing="12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HistoryHeadingText" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button x:Name="HistorySeeAllButton" Grid.Column="1" VerticalAlignment="Center" Click="HistorySeeAllButton_Click" Style="{StaticResource TextBlockButtonStyle}" />
                    </Grid>
                    <Grid x:Name="HistoryRowGrid" Height="196">
                        <ItemsRepeater
                            x:Name="HistoryRepeater"
                            HorizontalAlignment="Left"
                            ItemTemplate="{StaticResource WatchHistoryTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="12" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="RecentSection" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="RecentHeadingText"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button
                            x:Name="SeeAllButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="SeeAllButton_Click"
                            Style="{StaticResource TextBlockButtonStyle}" />
                    </Grid>
                    <Grid x:Name="RecentRowGrid" Height="{StaticResource MediaCardItemHeight}">
                        <GridView
                            x:Name="RecentGrid"
                            ItemClick="RecentGrid_ItemClick"
                            ItemTemplate="{StaticResource MovieCardTemplate}"
                            Style="{StaticResource MediaGridViewStyle}">
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection />
                            </GridView.ItemContainerTransitions>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        ItemHeight="{StaticResource MediaCardItemHeight}"
                                        ItemWidth="{StaticResource MediaCardItemWidth}"
                                        MaximumRowsOrColumns="1"
                                        Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
