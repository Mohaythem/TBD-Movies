<!--
    TV show details.

    TV hero band (2:3 poster and bounded copy column, progress
    line, Play Next Episode / Add to List / more), then horizontal season selector tabs
    and the episode cards list for the active season.
-->
<Page
    x:Class="TBDMovies.UI.Views.TVShowDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TBDMovies.UI.Models"
    KeyDown="Page_KeyDown"
    Background="Transparent">

    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="TvDetailsTitleStyle" BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource FigmaTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="LineHeight" Value="40" />
            <Setter Property="LineStackingStrategy" Value="MaxHeight" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBlock" x:Key="TvDetailsOverviewStyle" BasedOn="{StaticResource SecondaryBodyTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource FigmaTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="LineStackingStrategy" Value="MaxHeight" />
        </Style>
        <Style TargetType="Button" x:Key="TvDetailsButtonStyle" BasedOn="{StaticResource SubtleControlButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource FigmaSurfaceControlBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource FigmaBorderDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource FigmaTextSecondaryBrush}" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style TargetType="Button" x:Key="TvDetailsSelectedButtonStyle" BasedOn="{StaticResource TvDetailsButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource FigmaAccentSelectedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource FigmaAccentButtonBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource FigmaTextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button" x:Key="TvDetailsAccentButtonStyle" BasedOn="{StaticResource AccentControlButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource FigmaAccentButtonBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource FigmaAccentForegroundBrush}" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="20,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}" Padding="32,32,32,48" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ShowWidthStates">
                <VisualState x:Name="ShowWideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1400" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroPosterColumn.Width" Value="420" />
                        <Setter Target="PosterSurface.Width" Value="420" />
                        <Setter Target="PosterSurface.Height" Value="630" />
                        <Setter Target="HeroGrid.ColumnSpacing" Value="40" />
                        <Setter Target="SecondaryActionsGrid.RowSpacing" Value="0" />
                        <Setter Target="SecondaryActionsGrid.Visibility" Value="Visible" />
                        <Setter Target="PlayNextButton.(Grid.Row)" Value="0" />
                        <Setter Target="PlayNextButton.(Grid.Column)" Value="0" />
                        <Setter Target="PlayNextButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="AddToListButton.(Grid.Row)" Value="0" />
                        <Setter Target="AddToListButton.(Grid.Column)" Value="1" />
                        <Setter Target="AddToListButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="MatchButton.(Grid.Row)" Value="0" />
                        <Setter Target="MatchButton.(Grid.Column)" Value="2" />
                        <Setter Target="MatchButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="MoreButton.(Grid.Row)" Value="0" />
                        <Setter Target="MoreButton.(Grid.Column)" Value="3" />
                        <Setter Target="MoreButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ShowWatchLaterButton.(Grid.Row)" Value="0" />
                        <Setter Target="ShowWatchLaterButton.(Grid.Column)" Value="0" />
                        <Setter Target="ShowFavoriteButton.(Grid.Row)" Value="0" />
                        <Setter Target="ShowFavoriteButton.(Grid.Column)" Value="1" />
                        <Setter Target="PersonalSecondColumn.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ShowMediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1120" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroPosterColumn.Width" Value="300" />
                        <Setter Target="PosterSurface.Width" Value="300" />
                        <Setter Target="PosterSurface.Height" Value="450" />
                        <Setter Target="HeroGrid.ColumnSpacing" Value="32" />
                        <Setter Target="SecondaryActionsGrid.RowSpacing" Value="8" />
                        <Setter Target="SecondaryActionsGrid.Visibility" Value="Visible" />
                        <Setter Target="PlayNextButton.(Grid.Row)" Value="0" />
                        <Setter Target="PlayNextButton.(Grid.Column)" Value="0" />
                        <Setter Target="PlayNextButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="AddToListButton.(Grid.Row)" Value="0" />
                        <Setter Target="AddToListButton.(Grid.Column)" Value="1" />
                        <Setter Target="AddToListButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="MatchButton.(Grid.Row)" Value="1" />
                        <Setter Target="MatchButton.(Grid.Column)" Value="0" />
                        <Setter Target="MatchButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="MoreButton.(Grid.Row)" Value="1" />
                        <Setter Target="MoreButton.(Grid.Column)" Value="1" />
                        <Setter Target="MoreButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ShowWatchLaterButton.(Grid.Row)" Value="0" />
                        <Setter Target="ShowWatchLaterButton.(Grid.Column)" Value="0" />
                        <Setter Target="ShowFavoriteButton.(Grid.Row)" Value="0" />
                        <Setter Target="ShowFavoriteButton.(Grid.Column)" Value="1" />
                        <Setter Target="PersonalSecondColumn.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ShowNarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroPosterColumn.Width" Value="220" />
                        <Setter Target="PosterSurface.Width" Value="220" />
                        <Setter Target="PosterSurface.Height" Value="330" />
                        <Setter Target="HeroGrid.ColumnSpacing" Value="24" />
                        <Setter Target="SecondaryActionsGrid.RowSpacing" Value="8" />
                        <Setter Target="SecondaryActionsGrid.Visibility" Value="Visible" />
                        <Setter Target="PlayNextButton.(Grid.Row)" Value="0" />
                        <Setter Target="PlayNextButton.(Grid.Column)" Value="0" />
                        <Setter Target="PlayNextButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="AddToListButton.(Grid.Row)" Value="1" />
                        <Setter Target="AddToListButton.(Grid.Column)" Value="0" />
                        <Setter Target="AddToListButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="MatchButton.(Grid.Row)" Value="2" />
                        <Setter Target="MatchButton.(Grid.Column)" Value="0" />
                        <Setter Target="MatchButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="MoreButton.(Grid.Row)" Value="2" />
                        <Setter Target="MoreButton.(Grid.Column)" Value="1" />
                        <Setter Target="MoreButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="PersonalSecondColumn.Width" Value="Auto" />
                        <Setter Target="ShowWatchLaterButton.(Grid.Row)" Value="0" />
                        <Setter Target="ShowWatchLaterButton.(Grid.Column)" Value="0" />
                        <Setter Target="ShowFavoriteButton.(Grid.Column)" Value="0" />
                        <Setter Target="ShowFavoriteButton.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ShowCompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Root.Padding" Value="24,32,24,48" />
                        <Setter Target="HeroPosterRow.Height" Value="Auto" />
                        <Setter Target="HeroCopyRow.Height" Value="Auto" />
                        <Setter Target="HeroPosterColumn.Width" Value="Auto" />
                        <Setter Target="PosterSurface.Width" Value="220" />
                        <Setter Target="PosterSurface.Height" Value="330" />
                        <Setter Target="PosterSurface.HorizontalAlignment" Value="Left" />
                        <Setter Target="HeroCopyPanel.(Grid.Column)" Value="0" />
                        <Setter Target="HeroCopyPanel.(Grid.Row)" Value="1" />
                        <Setter Target="HeroCopyPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SecondaryActionsGrid.RowSpacing" Value="8" />
                        <Setter Target="SecondaryActionsGrid.Visibility" Value="Visible" />
                        <Setter Target="PlayNextButton.(Grid.Row)" Value="0" />
                        <Setter Target="PlayNextButton.(Grid.Column)" Value="0" />
                        <Setter Target="PlayNextButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="AddToListButton.(Grid.Row)" Value="1" />
                        <Setter Target="AddToListButton.(Grid.Column)" Value="0" />
                        <Setter Target="AddToListButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="MatchButton.(Grid.Row)" Value="2" />
                        <Setter Target="MatchButton.(Grid.Column)" Value="0" />
                        <Setter Target="MatchButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="MoreButton.(Grid.Row)" Value="2" />
                        <Setter Target="MoreButton.(Grid.Column)" Value="1" />
                        <Setter Target="MoreButton.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="PersonalSecondColumn.Width" Value="Auto" />
                        <Setter Target="ShowWatchLaterButton.(Grid.Row)" Value="0" />
                        <Setter Target="ShowWatchLaterButton.(Grid.Column)" Value="0" />
                        <Setter Target="ShowFavoriteButton.(Grid.Column)" Value="0" />
                        <Setter Target="ShowFavoriteButton.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="PageContent">
            <InfoBar
                x:Name="PathCopiedInfoBar"
                IsOpen="False"
                Severity="Success"
                IsClosable="True"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                MaxWidth="650"
                Canvas.ZIndex="100"
                Margin="0,8,0,0" />
            <StackPanel>
                <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,32">
                    <Grid x:Name="HeroGrid" ColumnSpacing="32" RowSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HeroPosterColumn" Width="420" />
                            <ColumnDefinition x:Name="HeroCopyColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="HeroPosterRow" Height="Auto" />
                            <RowDefinition x:Name="HeroCopyRow" Height="0" />
                        </Grid.RowDefinitions>

                        <Border x:Name="PosterSurface" Width="420" Height="630" Grid.Row="0" VerticalAlignment="Top" Style="{StaticResource ShowPosterSurfaceStyle}">
                            <Grid>
                                <Image x:Name="PosterImage" Stretch="Uniform" />
                                <FontIcon x:Name="PosterGlyph" FontSize="48" Foreground="{ThemeResource PosterGlyphForegroundBrush}" Glyph="&#xE7F4;" />
                            </Grid>
                        </Border>

                        <StackPanel x:Name="HeroCopyPanel" Grid.Column="1" Grid.Row="0" Spacing="24">
                            <TextBlock x:Name="KindText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            <StackPanel x:Name="ReadingPane" Spacing="24">
                                <Grid x:Name="ShowTitleContainer" VerticalAlignment="Center">
                                    <StackPanel x:Name="ShowTitleViewPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="ShowTitleText"
                                                   Style="{StaticResource TvDetailsTitleStyle}"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="False"
                                                   PointerPressed="ShowTitleText_PointerPressed"
                                                   DoubleTapped="ShowTitleText_DoubleTapped"
                                                   KeyDown="ShowTitleText_KeyDown"
                                                   IsTabStop="True" />
                                        <Border x:Name="ShowTitleCopiedBadge"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="ShowTitleCopiedText"
                                                       Text="Copied!"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBox x:Name="ShowTitleEditBox"
                                             FontSize="28"
                                             FontWeight="SemiBold"
                                             MaxLength="500"
                                             Visibility="Collapsed"
                                             VerticalAlignment="Center"
                                             KeyDown="ShowTitleEditBox_KeyDown"
                                             LostFocus="ShowTitleEditBox_LostFocus" />
                                </Grid>
                                <Grid ColumnSpacing="16" x:Name="ShowIdentityGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ShowMetaText" Style="{StaticResource SecondaryBodyTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Border x:Name="RatingPanel"
                                            Grid.Column="1"
                                            Style="{StaticResource StatusPillStyle}"
                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                        <StackPanel Spacing="6" Orientation="Horizontal" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource FigmaStatusStorageGoldBrush}" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource SecondaryBodyTextStyle}" x:Name="RatingText" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="OverviewText" HorizontalAlignment="Left" MaxWidth="{StaticResource ProseMaxWidth}" Style="{StaticResource TvDetailsOverviewStyle}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="ProgressValueText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="ProgressLabelText" VerticalAlignment="Bottom" Style="{StaticResource SecondaryCaptionTextStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="PlayNextEpisodeText" Style="{StaticResource SecondaryCaptionTextStyle}" TextWrapping="Wrap" />
                                <Grid x:Name="SecondaryActionsGrid" ColumnSpacing="8" RowSpacing="8" HorizontalAlignment="Left" Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button x:Name="PlayNextButton" Grid.Column="0" HorizontalAlignment="Left" Click="PlayNextButton_Click" Style="{StaticResource TvDetailsAccentButtonStyle}">
                                        <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon x:Name="PlayNextGlyph" FontSize="15" Glyph="&#xE768;" VerticalAlignment="Center" />
                                            <TextBlock x:Name="PlayNextText" Grid.Column="1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                    <DropDownButton x:Name="AddToListButton" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource TvDetailsButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                                            <TextBlock x:Name="AddToListText" Grid.Column="1" TextWrapping="Wrap" />
                                        </Grid>
                                        <DropDownButton.Flyout><MenuFlyout x:Name="AddToListFlyout" Opening="AddToListFlyout_Opening" Placement="BottomEdgeAlignedLeft" /></DropDownButton.Flyout>
                                    </DropDownButton>
                                    <Button x:Name="MatchButton" Grid.Column="2" HorizontalAlignment="Left" Click="MatchButton_Click" Style="{StaticResource TvDetailsButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon x:Name="MatchGlyph" FontSize="14" Glyph="&#xE721;" />
                                            <ProgressRing x:Name="MatchProgress" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                                            <TextBlock x:Name="MatchText" Grid.Column="1" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="MoreButton" Grid.Column="3" Width="40" Padding="4" HorizontalAlignment="Left" Style="{StaticResource TvDetailsButtonStyle}">
                                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                                        <Button.Flyout><MenuFlyout Placement="Bottom"><MenuFlyoutItem x:Name="MarkShowWatchedItem" IsEnabled="False"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem x:Name="OpenShowFolderItem" IsEnabled="False"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutSeparator /><MenuFlyoutItem x:Name="RemoveShowFromLibraryItem" Click="RemoveShowFromLibrary_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></Button.Flyout>
                                    </Button>
                                </Grid>
                                <Grid x:Name="PersonalActionsGrid" HorizontalAlignment="Left" ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition x:Name="PersonalSecondColumn" Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button x:Name="ShowWatchLaterButton" HorizontalAlignment="Left" Click="ShowWatchLaterButton_Click" AutomationProperties.AutomationId="ShowWatchLaterButton" Style="{StaticResource TvDetailsButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon x:Name="ShowWatchLaterGlyph" FontSize="16" Glyph="&#xE734;" />
                                            <TextBlock x:Name="ShowWatchLaterText" Grid.Column="1" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="ShowFavoriteButton" Grid.Column="1" HorizontalAlignment="Left" Click="ShowFavoriteButton_Click" AutomationProperties.AutomationId="ShowFavoriteButton" Style="{StaticResource TvDetailsButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon x:Name="ShowFavoriteGlyph" FontSize="16" Glyph="&#xEB51;" />
                                            <TextBlock x:Name="ShowFavoriteText" Grid.Column="1" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Margin="0,32,0,0" Spacing="24">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="SeasonsTitleText" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentSeasonMetaText" Style="{StaticResource SecondaryCaptionTextStyle}" Foreground="{ThemeResource FigmaTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Horizontal Season Selector Tabs -->
                    <ScrollViewer x:Name="SeasonTabsScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="0,4,0,8"
                                  KeyDown="SeasonTabs_KeyDown">
                        <ItemsRepeater x:Name="SeasonTabsRepeater">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:SeasonTabItem">
                                    <Grid Margin="0,0,8,0">
                                        <Button
                                            Click="SeasonTab_Click"
                                            KeyDown="SeasonTabs_KeyDown"
                                            Tag="{x:Bind}"
                                            AutomationProperties.Name="{x:Bind Title}"
                                            Style="{StaticResource TvDetailsSelectedButtonStyle}"
                                            Visibility="{x:Bind IsSelected, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" />
                                        </Button>
                                        <Button
                                            Click="SeasonTab_Click"
                                            KeyDown="SeasonTabs_KeyDown"
                                            Tag="{x:Bind}"
                                            AutomationProperties.Name="{x:Bind Title}"
                                            Style="{StaticResource TvDetailsButtonStyle}"
                                            Visibility="{x:Bind IsUnselected, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="Normal" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <!-- Episode Cards List -->
                    <ItemsRepeater x:Name="EpisodesRepeater" Margin="0,16,0,0">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:EpisodeDisplayRecord">
                                <Border
                                    MinHeight="120"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Opacity="{x:Bind RowOpacity}"
                                    Padding="16,16">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="192" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Episode Thumbnail (16:9) -->
                                        <Border
                                            Width="192"
                                            Height="108"
                                            VerticalAlignment="Center"
                                            CornerRadius="6"
                                            Background="{ThemeResource FigmaSurfaceControlBrush}"
                                            BorderBrush="{ThemeResource FigmaBorderDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid>
                                                <StackPanel
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Spacing="4"
                                                    Visibility="{x:Bind FallbackArtVisibility, Mode=OneWay}">
                                                    <FontIcon
                                                        FontSize="28"
                                                        Foreground="{ThemeResource FigmaTextTertiaryBrush}"
                                                        Glyph="&#xE7F4;"
                                                        HorizontalAlignment="Center" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        Foreground="{ThemeResource FigmaTextTertiaryBrush}"
                                                        Text="{x:Bind ThumbnailLabel}" />
                                                </StackPanel>
                                                <Image
                                                    Source="{x:Bind ArtworkSource, Mode=OneWay}"
                                                    Stretch="UniformToFill"
                                                    Visibility="{x:Bind ArtworkVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </Border>

                                        <!-- Center Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                FontSize="15"
                                                Text="{x:Bind FormattedTitle}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                Foreground="{ThemeResource FigmaTextSecondaryBrush}"
                                                Text="{x:Bind SubtitleMeta}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Style="{StaticResource TvDetailsOverviewStyle}"
                                                FontSize="13"
                                                LineHeight="18"
                                                Foreground="{ThemeResource FigmaTextSecondaryBrush}"
                                                Text="{x:Bind Overview}"
                                                TextWrapping="Wrap"
                                                MaxLines="3"
                                                TextTrimming="CharacterEllipsis"
                                                Margin="0,4,0,0"
                                                Visibility="{x:Bind OverviewVisibility}" />
                                        </StackPanel>

                                        <!-- Status Badges -->
                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <Border Style="{StaticResource StatusPillStyle}" Visibility="{x:Bind Watched, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                        Glyph="&#xE73E;" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Labels.Watched}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource StatusPillStyle}" Visibility="{x:Bind IsMissing, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                        Glyph="&#xE7BA;" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Labels.Missing}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource StatusPillStyle}" Visibility="{x:Bind StorageUnavailable, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                        Glyph="&#xEA6A;" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Labels.StorageUnavailable}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel
                                            Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind HasActions}">
                                            <Button
                                                AutomationProperties.Name="{x:Bind PlayOrRelinkLabel, Mode=OneWay}"
                                                Click="EpisodePlay_Click"
                                                IsEnabled="{x:Bind CanPlayOrRelink, Mode=OneWay}"
                                                Style="{StaticResource TvDetailsAccentButtonStyle}"
                                                Padding="12,6"
                                                MinHeight="36"
                                                CornerRadius="6"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="{x:Bind PlayOrRelinkLabel, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon FontSize="12" Glyph="{x:Bind PlayOrRelinkGlyph, Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind PlayOrRelinkLabel, Mode=OneWay}" FontSize="13" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="{x:Bind MarkWatchedLabel, Mode=OneWay}"
                                                Click="EpisodeMarkWatched_Click"
                                                IsEnabled="{x:Bind CanMarkWatched, Mode=OneWay}"
                                                Style="{StaticResource SubtleIconActionButtonStyle}"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="{x:Bind MarkWatchedLabel, Mode=OneWay}">
                                                <FontIcon FontSize="14" Glyph="&#xE73E;" />
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="{x:Bind Labels.OpenFolder}"
                                                Click="EpisodeOpenFolder_Click"
                                                IsEnabled="{x:Bind CanOpenFile, Mode=OneWay}"
                                                Style="{StaticResource SubtleIconActionButtonStyle}"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="{x:Bind Labels.OpenFolder}">
                                                <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="{x:Bind Labels.More}"
                                                Click="EpisodeDetails_Click"
                                                Style="{StaticResource SubtleIconActionButtonStyle}"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="{x:Bind Labels.More}">
                                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
