<Page
    x:Class="TBDMovies.UI.Views.CheckLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TBDMovies.UI.Controls"
    xmlns:models="using:TBDMovies.UI.Models"
    Background="Transparent">

    <ScrollViewer x:Name="Root" Style="{StaticResource PageScrollViewerStyle}">
        <Grid>
            <StackPanel Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="DescriptionText"
                        Style="{StaticResource SecondaryBodyTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--  .check-shield: the designed status tile that fronts the card.  -->
                            <Border
                                Width="48"
                                Height="48"
                                VerticalAlignment="Center"
                                Style="{StaticResource TileSurfaceStyle}">
                                <FontIcon
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="20"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE72E;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock x:Name="CheckHeadingText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="CheckHelpText"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="CancelCheckButton"
                                    Click="CancelCheckButton_Click"
                                    Style="{StaticResource SubtleControlButtonStyle}"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="RunCheckButton"
                                    Click="RunCheckButton_Click"
                                    Style="{StaticResource AccentControlButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="CheckProgressPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="CheckProgressText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                            <ProgressBar x:Name="CheckProgressBar" Height="4" />
                        </StackPanel>

                        <StackPanel x:Name="CheckSummaryPanel" Spacing="12" Visibility="Collapsed">
                            <Border Style="{StaticResource HairlineDividerStyle}" />
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="SummaryHeadingText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="SummaryHelpText"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="32">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Name="PassedValueText"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="PassedLabelText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Name="AttentionValueText"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="AttentionLabelText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="TotalValueText" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="TotalLabelText" Style="{StaticResource SecondaryCaptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar x:Name="CrashTempInfo" IsOpen="False" IsClosable="False" Severity="Warning">
                    <InfoBar.Content>
                        <TextBlock x:Name="CrashTempPaths" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </InfoBar.Content>
                </InfoBar>

                <StackPanel x:Name="IssuesSection" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="IssuesHeadingText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border x:Name="IssuesSurface" Style="{StaticResource ListSurfaceBorderStyle}">
                        <ItemsRepeater x:Name="IssuesRepeater">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:LibraryIssueDisplayRecord">
                                    <Border Style="{StaticResource RowDividerStyle}">
                                        <Grid ColumnSpacing="12" MinHeight="56">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Glyph="&#xE7BA;" />
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Item}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Style="{StaticResource TertiaryCaptionTextStyle}"
                                                    Text="{x:Bind Issue}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                                <Button
                                                    x:Name="RelinkButton"
                                                    Click="RelinkAction_Click"
                                                    Content="{x:Bind EffectiveRelinkLabel, Mode=OneTime}"
                                                    Tag="{x:Bind MediaFileId}"
                                                    Visibility="{x:Bind HasMediaFileVisibility, Mode=OneTime}"
                                                    Style="{StaticResource AccentControlButtonStyle}" />
                                                <Button
                                                    x:Name="IssueActionButton"
                                                    Click="IssueAction_Click"
                                                    Tag="{x:Bind}"
                                                    Style="{StaticResource SubtleControlButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE890;" FontSize="12" FontFamily="{StaticResource SymbolThemeFontFamily}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind ActionLabel}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                    <ItemsRepeater x:Name="TvShowRelinkRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:TvShowRelinkGroupRecord">
                                <Border Style="{StaticResource ListSurfaceBorderStyle}">
                                    <StackPanel Spacing="0">
                                        <Grid ColumnSpacing="8" MinHeight="56">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Padding="12,10"
                                                Click="ShowGroupToggle_Click"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="{x:Bind ExpandLabel, Mode=OneWay}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                        FontSize="16"
                                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                        Glyph="&#xE7BA;" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="{x:Bind ShowTitle, Mode=OneTime}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Style="{StaticResource TertiaryCaptionTextStyle}"
                                                            Text="{x:Bind MissingCountText, Mode=OneTime}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,4,0"
                                                Click="ShowGroupView_Click"
                                                Tag="{x:Bind ShowId}"
                                                Style="{StaticResource SubtleControlButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE890;" FontSize="12" FontFamily="{StaticResource SymbolThemeFontFamily}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind ViewLabel, Mode=OneTime}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"
                                                Click="ShowGroupToggle_Click"
                                                Tag="{x:Bind}"
                                                Style="{StaticResource SubtleIconActionButtonStyle}"
                                                AutomationProperties.Name="{x:Bind ExpandLabel, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind ExpandLabel, Mode=OneWay}">
                                                <FontIcon
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    FontSize="12"
                                                    Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                                            </Button>
                                        </Grid>
                                        <Border
                                            Style="{StaticResource HairlineDividerStyle}"
                                            Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}" />
                                        <ItemsRepeater
                                            ItemsSource="{x:Bind Episodes, Mode=OneTime}"
                                            Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="0" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:TvEpisodeRelinkRow">
                                                    <Border Style="{StaticResource RowDividerStyle}" Padding="40,8,12,8">
                                                        <Grid ColumnSpacing="12" MinHeight="44">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                Text="{x:Bind EpisodeCode, Mode=OneTime}" />
                                                            <StackPanel
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Spacing="2">
                                                                <TextBlock
                                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                                    Text="{x:Bind PrimaryLabel, Mode=OneTime}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Style="{StaticResource TertiaryCaptionTextStyle}"
                                                                    Text="{x:Bind SecondaryLabel, Mode=OneTime}"
                                                                    Visibility="{x:Bind SecondaryVisibility, Mode=OneTime}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Button
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                Click="RelinkAction_Click"
                                                                Content="{x:Bind RelinkLabel, Mode=OneTime}"
                                                                Tag="{x:Bind MediaFileId}"
                                                                Style="{StaticResource AccentControlButtonStyle}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <controls:EmptyStateCard
                    x:Name="NoIssuesState"
                    Glyph="&#xE73E;"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
