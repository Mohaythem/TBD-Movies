<UserControl
    x:Class="TBDMovies.UI.Controls.EmptyStateCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Left">

    <Grid>
        <!-- Framed Compact State (Used in Cards / Operations / Compact Surfaces) -->
        <Border
            x:Name="FramedState"
            MaxWidth="{StaticResource EmptyStateMaxWidth}"
            Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="36"
                    Height="36"
                    VerticalAlignment="Top"
                    Style="{StaticResource TileSurfaceStyle}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Framed Vector Views (scaled in 20x20 viewbox) -->
                        <Viewbox x:Name="FramedLibraryView" Width="20" Height="20" Visibility="Collapsed">
                            <Canvas Width="48" Height="48">
                                <Path
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeThickness="2"
                                    StrokeLineJoin="Round"
                                    Data="M 8,6 H 32 A 3,3 0 0 1 35,9 V 39 A 3,3 0 0 1 32,42 H 8 A 3,3 0 0 1 5,39 V 9 A 3,3 0 0 1 8,6 Z M 5,14 H 35" />
                                <Path
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Data="M 16,21 L 24,25.5 L 16,30 Z" />
                                <Path
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeThickness="2"
                                    Data="M 32,15 A 13,13 0 1 1 31.99,15 Z" />
                                <Path
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Data="M 32,25.5 A 2.5,2.5 0 1 1 31.99,25.5 Z" />
                            </Canvas>
                        </Viewbox>

                        <Viewbox x:Name="FramedNoResultsView" Width="20" Height="20" Visibility="Collapsed">
                            <Canvas Width="48" Height="48">
                                <Path
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeThickness="2"
                                    Data="M 6,10 H 42 A 2,2 0 0 1 44,12 V 23 A 2,2 0 0 1 42,25 H 6 A 2,2 0 0 1 4,23 V 12 A 2,2 0 0 1 6,10 Z" />
                                <Path
                                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                    StrokeThickness="2.5"
                                    Data="M 23,16 A 10.5,10.5 0 1 1 22.99,16 Z" />
                                <Path
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeThickness="3.5"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    Data="M 30.5,34 L 41,44.5" />
                            </Canvas>
                        </Viewbox>

                        <Viewbox x:Name="FramedListsView" Width="20" Height="20" Visibility="Collapsed">
                            <Canvas Width="48" Height="48">
                                <Path
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeThickness="2"
                                    StrokeLineJoin="Round"
                                    Data="M 9,13 H 39 A 3,3 0 0 1 42,16 V 20.5 A 3.5,3.5 0 0 0 42,27.5 V 32 A 3,3 0 0 1 39,35 H 9 A 3,3 0 0 1 6,32 V 27.5 A 3.5,3.5 0 0 0 6,20.5 V 16 A 3,3 0 0 1 9,13 Z" />
                                <Path
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Data="M 16,19 L 24,24 L 16,29 Z" />
                            </Canvas>
                        </Viewbox>

                        <FontIcon
                            x:Name="FramedGlyphIcon"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind Glyph, Mode=OneWay}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource SecondaryBodyTextStyle}"
                        Text="{x:Bind Message, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,8,0,0"
                        Click="ActionButton_Click"
                        Content="{x:Bind ActionText, Mode=OneWay}"
                        Style="{StaticResource SubtleControlButtonStyle}"
                        Visibility="{x:Bind IsActionVisible, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Frameless Hero State (Used in Library, Lists, Trakt, Main Grid Views) -->
        <StackPanel
            x:Name="FramelessState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">

            <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
                <!-- 1. Empty Library: Cinema Film Reel & Poster Outline with Subtle Theme Stroke -->
                <Viewbox x:Name="FramelessLibraryView" Width="64" Height="64" Visibility="Collapsed">
                    <Canvas Width="48" Height="48">
                        <!-- Poster Outline with Header Divider -->
                        <Path
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeThickness="1.5"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M 8,6 H 32 A 3,3 0 0 1 35,9 V 39 A 3,3 0 0 1 32,42 H 8 A 3,3 0 0 1 5,39 V 9 A 3,3 0 0 1 8,6 Z M 5,14 H 35" />
                        <!-- Poster Play Prism Accent in Cinema Gold -->
                        <Path
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            Data="M 16,21 L 24,25.5 L 16,30 Z" />
                        <!-- Cinema Film Reel Outer Spool -->
                        <Path
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeThickness="1.5"
                            Data="M 32,15 A 13,13 0 1 1 31.99,15 Z" />
                        <!-- Reel Hub Outline -->
                        <Path
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeThickness="1.5"
                            Data="M 32,24 A 4,4 0 1 1 31.99,24 Z" />
                        <!-- Reel Hub Center Pin in Cinema Gold -->
                        <Path
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            Data="M 32,26.2 A 1.8,1.8 0 1 1 31.99,26.2 Z" />
                        <!-- Reel Radial Perforations -->
                        <Path
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeThickness="1.25"
                            Data="M 32,17.2 A 2,2 0 1 1 31.99,17.2 Z M 32,34.8 A 2,2 0 1 1 31.99,34.8 Z M 23.2,26 A 2,2 0 1 1 23.19,26 Z M 40.8,26 A 2,2 0 1 1 40.79,26 Z" />
                        <!-- Subtle Film Strip Ribbon Tail -->
                        <Path
                            Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                            StrokeThickness="1.25"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M 32,41 C 36,41 40,43 44,43" />
                    </Canvas>
                </Viewbox>

                <!-- 2. No Search Results: Film Strip & Magnifying Glass -->
                <Viewbox x:Name="FramelessNoResultsView" Width="64" Height="64" Visibility="Collapsed">
                    <Canvas Width="48" Height="48">
                        <!-- Film Strip Outline -->
                        <Path
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeThickness="1.5"
                            StrokeLineJoin="Round"
                            Data="M 6,10 H 42 A 2,2 0 0 1 44,12 V 23 A 2,2 0 0 1 42,25 H 6 A 2,2 0 0 1 4,23 V 12 A 2,2 0 0 1 6,10 Z" />
                        <!-- Film Strip Frame Dividers -->
                        <Path
                            Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                            StrokeThickness="1.2"
                            Data="M 15,10 V 25 M 26,10 V 25 M 37,10 V 25" />
                        <!-- Film Strip Perforations -->
                        <Path
                            Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                            StrokeThickness="1"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M 8,12 H 10 M 19,12 H 21 M 30,12 H 32 M 40,12 H 42 M 8,23 H 10 M 19,23 H 21 M 30,23 H 32 M 40,23 H 42" />
                        <!-- Magnifying Glass Lens in Cinema Gold Accent -->
                        <Path
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                            StrokeThickness="2"
                            Data="M 23,16 A 10.5,10.5 0 1 1 22.99,16 Z" />
                        <!-- Magnifying Glass Focus Crosshair -->
                        <Path
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeThickness="1.2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M 20,26.5 H 26 M 23,23.5 V 29.5" />
                        <!-- Magnifying Glass Handle -->
                        <Path
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeThickness="3"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M 30.5,34 L 41,44.5" />
                    </Canvas>
                </Viewbox>

                <!-- 3. Empty Lists: Classic Cinema Ticket Outline -->
                <Viewbox x:Name="FramelessListsView" Width="64" Height="64" Visibility="Collapsed">
                    <Canvas Width="48" Height="48">
                        <!-- Cinema Ticket Body with Side Notches -->
                        <Path
                            Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                            StrokeThickness="1.5"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M 9,13 H 39 A 3,3 0 0 1 42,16 V 20.5 A 3.5,3.5 0 0 0 42,27.5 V 32 A 3,3 0 0 1 39,35 H 9 A 3,3 0 0 1 6,32 V 27.5 A 3.5,3.5 0 0 0 6,20.5 V 16 A 3,3 0 0 1 9,13 Z" />
                        <!-- Ticket Perforation Separator -->
                        <Path
                            Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                            StrokeThickness="1.2"
                            StrokeDashArray="1,2"
                            Data="M 32,13.5 V 34.5" />
                        <!-- Cinema Play Prism Accent in Cinema Gold -->
                        <Path
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            Data="M 16,19 L 24,24 L 16,29 Z" />
                        <!-- Stub Barcode / Punch Notches -->
                        <Path
                            Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M 36,20 H 38 M 36,24 H 38 M 36,28 H 38" />
                        <!-- Top Header Accent Line -->
                        <Path
                            Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                            StrokeThickness="1"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M 12,16.5 H 28" />
                    </Canvas>
                </Viewbox>

                <!-- FontIcon fallback for Default / generic states -->
                <FontIcon
                    x:Name="FramelessGlyphIcon"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind Glyph, Mode=OneWay}"
                    Visibility="Collapsed" />
            </Grid>

            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Title, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                MaxWidth="480"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryBodyTextStyle}"
                Text="{x:Bind Message, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Click="ActionButton_Click"
                Content="{x:Bind ActionText, Mode=OneWay}"
                Style="{StaticResource SubtleControlButtonStyle}"
                Visibility="{x:Bind IsActionVisible, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
