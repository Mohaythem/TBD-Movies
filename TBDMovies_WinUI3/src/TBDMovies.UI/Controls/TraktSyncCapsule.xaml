<UserControl
    x:Class="TBDMovies.UI.Controls.TraktSyncCapsule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Visibility="Collapsed">

    <Border
        x:Name="CapsuleBorder"
        Height="36"
        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="10,0,6,0"
        VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <!-- Green Success Health Indicator Dot -->
            <Ellipse
                x:Name="SyncStatusDot"
                Width="6"
                Height="6"
                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                VerticalAlignment="Center"
                Margin="0,0,2,0"
                Visibility="Collapsed" />

            <!-- Active Sync Progress Details -->
            <StackPanel
                x:Name="SyncProgressContainer"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <ProgressBar
                    x:Name="SyncProgressBar"
                    Width="80"
                    Height="4"
                    Minimum="0"
                    Maximum="8"
                    Value="0"
                    CornerRadius="2"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="SyncProgressCounter"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    FontSize="11"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Status / Last Synced Timestamp -->
            <TextBlock
                x:Name="SyncStatusText"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                FontSize="12"
                VerticalAlignment="Center"
                Visibility="Collapsed" />

            <!-- Borderless Subtle Refresh Button (No nested border) -->
            <Button
                x:Name="SyncNowButton"
                Click="SyncNowButton_Click"
                Style="{StaticResource SyncActionButtonStyle}"
                AllowFocusOnInteraction="False"
                VerticalAlignment="Center">
                <FontIcon
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="11"
                    Glyph="&#xE895;" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
